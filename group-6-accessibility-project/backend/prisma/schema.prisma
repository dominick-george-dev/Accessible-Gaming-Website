generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id                    Int                     @id @default(autoincrement())
  title                 String
  description           String
  genre                 String[]
  releaseDate           DateTime
  updatedAt             DateTime                @updatedAt
  createdAt             DateTime                @default(now())
  developer             String
  rating                Float
  hasBeenVerified       Boolean                 @default(false)
  images                String[]
  publisherId           Int?
  trailer               String?
  transcript            String?
  Publisher             Publisher?              @relation(fields: [publisherId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "publisherId")
  gameAccessibilityTags GameAccessibilityTags[]
  reviews               Review[]
  View                  View[]
}

model AccessibilityTags {
  id                    Int                     @id @default(autoincrement())
  tag                   String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  category              String
  gameAccessibilityTags GameAccessibilityTags[]
}

model GameAccessibilityTags {
  gameId              Int
  accessibilityTagsId Int
  accessibilityTags   AccessibilityTags @relation(fields: [accessibilityTagsId], references: [id])
  game                Game              @relation(fields: [gameId], references: [id])

  @@id([gameId, accessibilityTagsId])
}

model Review {
  id                    Int      @id @default(autoincrement())
  gameId                Int
  userId                Int
  rating                Int
  comment               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  accessibilityFeedback String[]
  helpful               Int      @default(0)
  userName              String
  game                  Game     @relation(fields: [gameId], references: [id])
  User                  User     @relation(fields: [userId], references: [id])
}

model User {
  id                        Int                        @id @default(autoincrement())
  email                     String                     @unique
  username                  String                     @unique
  password                  String                     @default("NEEDS_PASSWORD_RESET") @db.VarChar(255)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  role                      roles                      @default(USER)
  Publisher                 Publisher[]
  Review                    Review[]
  UserAccessibilitySettings UserAccessibilitySettings?
}

model UserAccessibilitySettings {
  id                          Int      @id @default(autoincrement())
  userId                      Int      @unique
  textSize                    String   @default("medium")
  fontFamily                  String   @default("default")
  highContrast                Boolean  @default(false)
  colorBlindMode              String   @default("none")
  colourMode                  String   @default("light-mode")
  visualAccessibility         Boolean  @default(false)
  hearingAccessibility        Boolean  @default(false)
  motorDexterityAccessibility Boolean  @default(false)
  cognitiveAccessibility      Boolean  @default(false)
  screenMagnifier             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  User                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Publisher {
  id             Int     @id @default(autoincrement())
  userId         Int
  displayName    String?
  profilePicture String?
  Game           Game[]
  User           User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "userId")
}

model View {
  id       Int      @id @default(autoincrement())
  gameId   Int
  viewedAt DateTime @default(now())
  Game     Game     @relation(fields: [gameId], references: [id])
}

enum roles {
  USER
  ADMIN
  PUBLISHER
}
