// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Game model representing a video game
model Game {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  images      String[] @default([])
  trailer     String @default("")
  transcript  String   @default("")
  genre       String[]
  releaseDate DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  developer   String
  publisher   String
  rating      Float

  reviews Review[]

  gameAccessibilityTags GameAccessibilityTags[]
}

// AccessibilityTags model representing various accessibility features
model AccessibilityTags {
  id                    Int                     @id @default(autoincrement())
  tag                   String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  category              String
  gameAccessibilityTags GameAccessibilityTags[]
}

// Junction table for many-to-many relationship between Game and AccessibilityTags
model GameAccessibilityTags {
  gameId              Int
  accessibilityTagsId Int
  accessibilityTags   AccessibilityTags @relation(fields: [accessibilityTagsId], references: [id])
  game                Game              @relation(fields: [gameId], references: [id])

  @@id([gameId, accessibilityTagsId])
}


// Review model representing user reviews for games
model Review {
  id                    Int      @id @default(autoincrement())
  gameId                Int
  userId                Int
  rating                Int
  comment               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  accessibilityFeedback String[]
  helpful               Int      @default(0)
  userName              String
  game                  Game     @relation(fields: [gameId], references: [id])
  User                  User     @relation(fields: [userId], references: [id])
}

// User model representing application users
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]
  accessibilitySettings UserAccessibilitySettings?
}

// UserAccessibilitySettings model for storing user accessibility preferences
model UserAccessibilitySettings {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  
  // Text settings
  textSize              Int   @default(16) // small, medium, large, extra-large
  fontFamily            String   @default("default") // default, dyslexia-friendly
    // Visual settings
  highContrast          Boolean  @default(false)
  colorBlindMode        String   @default("none") // none, protanopia, deuteranopia, tritanopia, monochrome
  colourMode            String   @default("light-mode") // light-mode, dark-mode, deep-space
  
  // Accessibility preferences
  visualAccessibility   Boolean  @default(false)
  hearingAccessibility  Boolean  @default(false)
  motorDexterityAccessibility Boolean @default(false)
  cognitiveAccessibility Boolean @default(false)
  
  // Magnifier
  screenMagnifier       Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
