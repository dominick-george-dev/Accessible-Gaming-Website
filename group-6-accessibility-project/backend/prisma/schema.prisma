// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Game model representing a video game
model Game {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  images      String[] @default([])
  trailer     String @default("")
  transcript  String   @default("")
  genre       String[]
  releaseDate DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  developer   String
  publisher   String
  rating      Float

  reviews Review[]

  gameAccessibilityTags GameAccessibilityTags[]
}

// AccessibilityTags model representing various accessibility features
model AccessibilityTags {
  id                    Int                     @id @default(autoincrement())
  tag                   String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  category              String
  gameAccessibilityTags GameAccessibilityTags[]
}

// Junction table for many-to-many relationship between Game and AccessibilityTags
model GameAccessibilityTags {
  gameId              Int
  accessibilityTagsId Int
  accessibilityTags   AccessibilityTags @relation(fields: [accessibilityTagsId], references: [id])
  game                Game              @relation(fields: [gameId], references: [id])

  @@id([gameId, accessibilityTagsId])
}


// Review model representing user reviews for games
model Review {
  id                    Int      @id @default(autoincrement())
  gameId                Int
  userId                Int
  rating                Int
  comment               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  accessibilityFeedback String[]
  helpful               Int      @default(0)
  userName              String
  game                  Game     @relation(fields: [gameId], references: [id])
  User                  User     @relation(fields: [userId], references: [id])
}

model User {
  id                        Int                        @id @default(autoincrement())
  email                     String                     @unique
  username                  String                     @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  password                  String                     @default("NEEDS_PASSWORD_RESET") @db.VarChar(255)
  Review                    Review[]
  UserAccessibilitySettings UserAccessibilitySettings?
}

model UserAccessibilitySettings {
  id                          Int      @id @default(autoincrement())
  userId                      Int      @unique
  textSize                    String   @default("medium")
  fontFamily                  String   @default("default")
  highContrast                Boolean  @default(false)
  colorBlindMode              String   @default("none")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  cognitiveAccessibility      Boolean  @default(false)
  colourMode                  String   @default("light-mode")
  hearingAccessibility        Boolean  @default(false)
  motorDexterityAccessibility Boolean  @default(false)
  screenMagnifier             Boolean  @default(false)
  visualAccessibility         Boolean  @default(false)
  User                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
