# Database Connection URL for Neon Database
# Copy this file to .env and replace with your actual values

# Your Neon database connection string
# Get this from your Neon dashboard at https://console.neon.tech/
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-1.aws.neon.tech/your-database-name?sslmode=require"

