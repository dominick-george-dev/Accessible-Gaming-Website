import { useState, useMemo, useEffect } from 'react';
import { Game } from '../types/game';
import { GameCard } from '../components/GameCard';
import { FilterPanel } from '../components/FilterPanel';
import { Input } from '../components/ui/input';
import { Button } from '../components/ui/button';
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from '../components/ui/sheet';
import { Card } from '../components/ui/card';
import { Search, Filter, Clock, X } from 'lucide-react';

interface BrowsePageProps {
  games: Game[];
  favorites: string[];
  onToggleFavorite: (gameId: string) => void;
  onGameClick: (gameId: string) => void;
}

const RECENT_SEARCHES_KEY = 'accessplay_recent_searches';
const MAX_RECENT_SEARCHES = 5;

export function BrowsePage({
  games,
  favorites,
  onToggleFavorite,
  onGameClick,
}: BrowsePageProps) {
  const [searchQuery, setSearchQuery] = useState('');
  const [showSuggestions, setShowSuggestions] = useState(false);
  const [recentSearches, setRecentSearches] = useState<string[]>([]);
  const [selectedCategories, setSelectedCategories] = useState({
    visual: false,
    hearing: false,
    dexterity: false,
    cognitive: false,
  });

  // Load recent searches from localStorage
  useEffect(() => {
    try {
      const stored = localStorage.getItem(RECENT_SEARCHES_KEY);
      if (stored) {
        setRecentSearches(JSON.parse(stored));
      }
    } catch (err) {
      console.error('Error loading recent searches:', err);
    }
  }, []);

  // Save search to recent searches
  const saveToRecentSearches = (query: string) => {
    if (!query.trim() || query.length < 2) return;
    
    try {
      const updated = [query, ...recentSearches.filter(s => s !== query)].slice(0, MAX_RECENT_SEARCHES);
      setRecentSearches(updated);
      localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(updated));
    } catch (err) {
      console.error('Error saving recent search:', err);
    }
  };

  // Clear a specific recent search
  const removeRecentSearch = (query: string) => {
    const updated = recentSearches.filter(s => s !== query);
    setRecentSearches(updated);
    localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(updated));
  };

  // Clear all recent searches
  const clearRecentSearches = () => {
    setRecentSearches([]);
    localStorage.removeItem(RECENT_SEARCHES_KEY);
  };

  // Generate search suggestions
  const suggestions = useMemo(() => {
    if (searchQuery.length < 2) return [];
    
    const query = searchQuery.toLowerCase();
    const matches: string[] = [];
    
    games.forEach((game) => {
      // Game names
      if (game.name.toLowerCase().includes(query) && !matches.includes(game.name)) {
        matches.push(game.name);
      }
      // Genres
      game.genre.forEach((genre) => {
        if (genre.toLowerCase().includes(query) && !matches.includes(genre)) {
          matches.push(genre);
        }
      });
      // Accessibility tags
      game.accessibilityTags.forEach((tag) => {
        if (tag.name.toLowerCase().includes(query) && !matches.includes(tag.name)) {
          matches.push(tag.name);
        }
      });
    });
    
    return matches.slice(0, 5);
  }, [searchQuery, games]);

  const handleCategoryChange = (category: string, checked: boolean) => {
    setSelectedCategories((prev) => ({
      ...prev,
      [category]: checked,
    }));
  };

  const activeFilterCount = Object.values(selectedCategories).filter(Boolean).length;

  // Filter games based on search and accessibility categories
  const filteredGames = games.filter((game) => {
    // Search filter
    const matchesSearch =
      searchQuery === '' ||
      game.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      game.genre.some((g) => g.toLowerCase().includes(searchQuery.toLowerCase())) ||
      game.accessibilityTags.some((tag) =>
        tag.name.toLowerCase().includes(searchQuery.toLowerCase())
      );

    // Accessibility filter
    const selectedCats = Object.entries(selectedCategories)
      .filter(([_, selected]) => selected)
      .map(([cat, _]) => cat);

    const matchesAccessibility =
      selectedCats.length === 0 ||
      selectedCats.every((cat) =>
        game.accessibilityTags.some((tag) => tag.category === cat)
      );

    return matchesSearch && matchesAccessibility;
  });

  return (
    <div className="max-w-7xl mx-auto">
      <div className="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8">
        {/* Desktop Filter Sidebar - Hidden on Mobile */}
        <div className="hidden lg:block lg:col-span-1">
          <div className="sticky top-24">
            <FilterPanel
              selectedCategories={selectedCategories}
              onCategoryChange={handleCategoryChange}
              activeFilterCount={activeFilterCount}
            />
          </div>
        </div>

        {/* Main Content */}
        <div className="lg:col-span-3 space-y-4 lg:space-y-6">
          {/* Search Bar with Autocomplete */}
          <div className="relative">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground pointer-events-none" aria-hidden="true" />
            <Input
              type="search"
              placeholder="Search games, genres, or features..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              onFocus={() => setShowSuggestions(true)}
              onBlur={() => setTimeout(() => setShowSuggestions(false), 200)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && searchQuery.trim()) {
                  saveToRecentSearches(searchQuery.trim());
                  setShowSuggestions(false);
                }
              }}
              className="pl-10"
              aria-label="Search games"
              aria-autocomplete="list"
              aria-controls="search-suggestions"
              aria-expanded={showSuggestions && (suggestions.length > 0 || recentSearches.length > 0)}
            />
            
            {/* Autocomplete Suggestions and Recent Searches */}
            {showSuggestions && (suggestions.length > 0 || (searchQuery.length === 0 && recentSearches.length > 0)) && (
              <Card 
                id="search-suggestions" 
                className="absolute top-full mt-1 w-full z-50 p-2"
                role="listbox"
              >
                {/* Recent Searches - Show when no query */}
                {searchQuery.length === 0 && recentSearches.length > 0 && (
                  <div className="mb-2">
                    <div className="flex items-center justify-between px-3 py-2">
                      <div className="flex items-center gap-2">
                        <Clock className="w-4 h-4 text-muted-foreground" aria-hidden="true" />
                        <span className="text-sm text-muted-foreground">Recent Searches</span>
                      </div>
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          clearRecentSearches();
                        }}
                        className="text-xs text-muted-foreground hover:text-foreground"
                        aria-label="Clear all recent searches"
                      >
                        Clear all
                      </button>
                    </div>
                    {recentSearches.map((recent, index) => (
                      <button
                        key={index}
                        className="w-full text-left px-3 py-2 rounded hover:bg-muted transition-colors flex items-center justify-between group"
                        onClick={() => {
                          setSearchQuery(recent);
                          saveToRecentSearches(recent);
                          setShowSuggestions(false);
                        }}
                        role="option"
                        aria-selected={false}
                      >
                        <div className="flex items-center gap-2">
                          <Clock className="w-4 h-4 text-muted-foreground" aria-hidden="true" />
                          <span>{recent}</span>
                        </div>
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            removeRecentSearch(recent);
                          }}
                          className="opacity-0 group-hover:opacity-100 transition-opacity"
                          aria-label={`Remove ${recent} from recent searches`}
                        >
                          <X className="w-4 h-4 text-muted-foreground hover:text-foreground" />
                        </button>
                      </button>
                    ))}
                  </div>
                )}

                {/* Search Suggestions */}
                {suggestions.length > 0 && (
                  <>
                    {searchQuery.length === 0 && recentSearches.length > 0 && (
                      <div className="border-t my-2" />
                    )}
                    {suggestions.map((suggestion, index) => (
                      <button
                        key={index}
                        className="w-full text-left px-3 py-2 rounded hover:bg-muted transition-colors"
                        onClick={() => {
                          setSearchQuery(suggestion);
                          saveToRecentSearches(suggestion);
                          setShowSuggestions(false);
                        }}
                        role="option"
                        aria-selected={false}
                      >
                        <div className="flex items-center gap-2">
                          <Search className="w-4 h-4 text-muted-foreground" aria-hidden="true" />
                          <span>{suggestion}</span>
                        </div>
                      </button>
                    ))}
                  </>
                )}
              </Card>
            )}
          </div>

          {/* Mobile Filter Button */}
          <div className="lg:hidden">
            <Sheet>
              <SheetTrigger asChild>
                <Button variant="outline" className="w-full gap-2">
                  <Filter className="w-4 h-4" aria-hidden="true" />
                  Filters
                  {activeFilterCount > 0 && (
                    <span className="bg-primary text-primary-foreground rounded-full px-2 py-0.5">
                      {activeFilterCount}
                    </span>
                  )}
                </Button>
              </SheetTrigger>
              <SheetContent side="bottom" className="max-h-[80vh]">
                <SheetHeader>
                  <SheetTitle>Filter Games</SheetTitle>
                </SheetHeader>
                <div className="mt-4">
                  <FilterPanel
                    selectedCategories={selectedCategories}
                    onCategoryChange={handleCategoryChange}
                    activeFilterCount={activeFilterCount}
                  />
                </div>
              </SheetContent>
            </Sheet>
          </div>

          {/* Results */}
          <div>
            <p className="text-muted-foreground mb-4 lg:mb-6" aria-live="polite" aria-atomic="true">
              Showing {filteredGames.length} {filteredGames.length === 1 ? 'game' : 'games'}
            </p>
            
            {filteredGames.length === 0 ? (
              <div className="text-center py-12 space-y-4">
                <p>No games found matching your criteria</p>
                <Button
                  variant="outline"
                  onClick={() => {
                    setSearchQuery('');
                    setSelectedCategories({
                      visual: false,
                      hearing: false,
                      dexterity: false,
                      cognitive: false,
                    });
                  }}
                >
                  Clear Filters
                </Button>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
                {filteredGames.map((game) => (
                  <GameCard
                    key={game.id}
                    game={game}
                    isFavorite={favorites.includes(game.id)}
                    onToggleFavorite={onToggleFavorite}
                    onClick={() => onGameClick(game.id)}
                  />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
